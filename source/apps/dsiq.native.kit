# Experimental native application specification, to run via a compatible NVIDIA Kit SDK.
# Do not bundle SDK/RTX binaries without checking NVIDIA's redistribution terms.
[package]
version = "0.1.0"
title = "DSIQ Native Studio"
description = "OpenUSD industrial digital twin foundation: experimental Kit host."
category = "Simulation"

[dependencies]
"omni.kit.uiapp" = {}
"omni.usd" = {}
"omni.kit.window.stage" = {}
"omni.kit.viewport.window" = {}
"dsiq.studio" = {}

[settings.app]
name = "DSIQ Native Studio"

[settings.app.window]
title = "DSIQ Native | Engineering Studio"
width = 1280
height = 800
