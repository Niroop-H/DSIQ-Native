# Experimental Kit-based DSIQ Native application; requires an installed licensed Kit SDK.
# The RTX 3050 is below NVIDIA's supported Kit GPU baseline. GPU launch unverified.
[package]
version = "0.2.0"
title = "DSIQ Native | Robotics & Engineering Studio"
description = "OpenUSD engineering scene authoring, reference robotics and physics lab"
category = "Simulation"

[dependencies]
"omni.kit.uiapp" = {}
"omni.usd" = {}
"omni.timeline" = {}
"omni.kit.window.stage" = {}
"omni.kit.viewport.window" = {}
"omni.physx" = {}
"dsiq.studio" = {}

[settings.app]
name = "DSIQ Native"

[settings.app.window]
title = "DSIQ Native | Engineering Studio"
width = 1440
height = 900
